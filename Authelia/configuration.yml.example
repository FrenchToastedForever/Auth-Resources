server:
  address: 'tcp://0.0.0.0:9091/'

log:
  level: info

jwt_secret: 'SECRET HERE'

default_2fa_method: 'totp'

totp:
  issuer: '[main domain]'

authentication_backend:
  password_reset:
    disable: false
#Optional LDAP configuration
  ldap:
    implementation: 'lldap'
    address: 'ldap://192.168.2.194:3890'
    base_dn: 'dc=frenchtoasted,dc=dev'
    user: 'uid=authelia_bind,ou=people,dc=frenchtoasted,dc=dev'
    password: '[LDAP Bind Password]'
access_control:
  default_policy: 'deny'
  rules:
    - domain: 'auth.[main domain]'
      policy: 'bypass'
    - domain: 'auth.[cloudflare worker user].workers.dev'
      policy: 'bypass'
    - domain: 'jellyfin.[main domain]'
      policy: 'two_factor'
    - domain: 'jellyfin.[cloudflare worker user].workers.dev'
      policy: 'two_factor'
    - domain: 'users.[main domain]'
      policy: 'bypass'
      networks:
        - 192.168.1.0/24  #
    - domain: 'users.[main domain]'
      policy: 'two_factor'
    - domain: 'users.[cloudflare worker user].workers.dev'
      policy: 'bypass'
      networks:
        - 192.168.1.0/24  #
    - domain: 'users.[cloudflare worker user].workers.dev'
      policy: 'two_factor'

#This section is automatically generated by authelia just here for reference
session:
  name: 'authelia_session'
  secret: '[SECRET]'
  expiration: '1h'
  inactivity: '15m'
  cookies:
    - domain: '[main domain]'
      authelia_url: 'https://auth.[main domain]'
    - domain: '[cloudflare worker user].workers.dev'
      authelia_url: 'https://auth.[cloudflare worker user].workers.dev'

#This section is automatically generated by authelia just here for reference
storage:
  encryption_key: '[SECRET]'
  local:
    path: '/config/db.sqlite3'

notifier:
  filesystem:
    filename: '/config/notification.txt'

#This section is automatically generated by authelia just here for reference
identity_providers:
  #You must specify OIDC
  oidc:
    jwks:
      - key_id: 'main'
        algorithm: 'RS256'
        use: 'sig'
        key: |
          -----BEGIN PRIVATE KEY-----
          ****************************************************************************************************************************************************************************
          -----END PRIVATE KEY-----

    cors:
      endpoints:
        - authorization
        - token
        - userinfo
      allowed_origins_from_client_redirect_uris: true
    #Example setup with Matrix OAUTH v2
    clients:
      - client_id: 'continuwuity'
        client_name: 'Continuwuity Matrix'
        client_secret: '************************'
        public: false
        authorization_policy: 'two_factor'
        redirect_uris:
          - 'https://matrix.[main domain]/_continuwuity/oidc/complete'
          - 'https://matrix.[main domain]/_continuwuity/oidc/complete/'
          - 'https://matrix.[cloudflare worker user].workers.dev/_continuwuity/oidc/complete'
          - 'https://matrix.[cloudflare worker user].workers.dev/_continuwuity/oidc/complete/'
        scopes:
          - 'openid'
          - 'profile'
          - 'email'
        response_types:
          - 'code'
        grant_types:
          - 'authorization_code'
